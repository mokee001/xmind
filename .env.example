# 复制此文件为 .env 并填入你自己的 key/token

# 阿里云百炼 (DashScope) API key, 用于 qwen3-vl-plus VLM 打分
# 申请地址: https://bailian.console.aliyun.com/?tab=api_key
DASHSCOPE_API_KEY=sk-your-key-here

# Figma Personal Access Token, 用于 fetch_figma_template.py 拉取设计稿
# 生成地址: Figma → Settings → Personal access tokens
FIGMA_ACCESS_TOKEN=figd_your-token-here
