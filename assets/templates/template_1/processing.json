{
  "template_id": "template_1",
  "version": "1.0.0",
  "default_processing": {
    "resize": true,
    "crop": true,
    "color_adjustment": false,
    "cutout": false,
    "segmentation": false,
    "background_removal": false,
    "upscale": false,
    "text_generation": true
  },
  "global_image_rules": {
    "minimum_resolution": {
      "short_side": 900
    },
    "allow_mobile_snapshots": true,
    "avoid": [
      "screenshot",
      "text_only_image",
      "severe_blur",
      "overexposed_face",
      "underexposed_photo",
      "duplicate_scene"
    ],
    "prefer": [
      "clear_subject",
      "natural_life_moment",
      "pleasant_color_mood",
      "scene_diversity",
      "low_duplicate_similarity"
    ]
  },
