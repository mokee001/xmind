  "photo_rules": {
    "required_photo_count": 8,
    "photo_source": "user_album",
    "selection": {
      "goal": "Select visually strong photos that fit a soft Plog collage style.",
      "prefer": [
        "clear_subject",
        "good_exposure",
        "low_blur",
        "pleasant_color_mood",
        "low_duplicate_similarity",
        "balanced_set_variety"
      ],
      "avoid": [
        "blurred_photo",
        "overexposed_photo",
        "underexposed_photo",
        "closed_eyes_when_face_is_primary_subject",
        "important_subject_near_crop_edge",
        "duplicate_or_near_duplicate_photo"
      ]
    },
    "preprocess_before_placement": {
      "required": true,
      "operation": "content_aware_square_crop",
      "target_aspect_ratio": "1:1",
      "description": "Each selected photo must be cropped to a square image according to its visual focus before it is placed into a photo slot.",
      "crop_priority": [
        "main_subject",
        "face",
        "salient_object",
        "composition_center",
        "visual_balance"
      ],
      "crop_avoid": [
        "cutting_face",
        "cutting_main_subject",
        "empty_center_crop",
        "placing_key_subject_too_close_to_edge"
      ]
    },
    "placement": {
      "target_layers": [
        "image_1",
        "image_2",
        "image_3",
        "image_4",
        "image_5",
        "image_6",
        "image_7",
        "image_8"
      ],
      "figma_image_fill_count_per_layer": 1,
      "figma_scale_mode": "FILL",
      "replace_image_fill": true,
      "preserve_layer_geometry": true,
      "preserve_layer_effects": true
    }
  },
  "copy_rules": {
    "text_1_to_text_3": {
      "task": "Generate three short sentence lines based on the selected photos.",
      "tone": [
        "soft",
        "daily",
        "lightweight",
        "visual",
        "calendar_friendly"
      ],
      "constraints": [
        "one_line_each",
        "match_the_photo_mood",
        "avoid_long_or_dense_text",
        "avoid_repeating_the_same_wording"
      ]
    },
    "text_4": {
      "task": "Generate one concise theme word or mood tag based on the selected photos.",
      "format": "short_title_case_or_single_phrase",
      "examples": [
        "Traveling",
        "Weekend",
        "Sunset",
        "Daily Life"
      ]
    },
    "nickname": {
      "task": "Use the current app user's nickname.",
      "source": "app.user.nickname",
      "fallback": "Me",
      "font": {
        "asset_id": "nickname_handwriting_font",
        "required": true,
        "rendering_requirement": "Load the bundled TTF font before rendering the nickname text. Do not substitute this layer with a system default font unless the asset is unavailable."
      },
      "length_handling": {
        "preferred_max_characters": 12,
        "if_too_long": "truncate_or_reduce_font_size_at_render_time"
      }
    },
    "’Plog": {
      "task": "Keep the fixed suffix unchanged.",
      "text": "’Plog"
    }
  },
  "model_io_contract": {
    "inputs": {
      "album_photos": "Array of user album photos with local URI, metadata, and optional visual embeddings.",
      "app_user": {
        "nickname": "Current app user nickname."
      }
    },
    "expected_output": {
