{
  "version": "recollections-rules-v1.0.0",
  "scope": "Reusable photo selection and aggregation code; no photo membership or dataset snapshot",
  "rules": {
    "recollection_feed": {
      "VERSION": "recollection-feed-v1",
      "RULES": {
        "minimum_photos": 12,
        "maximum_photos": 24,
        "featured_count": 4,
        "text_only_min": 0.245,
        "text_margin": 0.025,
        "vision_min": 0.5,
        "album_containment": 0.65,
        "recent_days": 7
      },
      "TOPICS": {
        "art": {
          "title": "光影中的艺术",
          "label": "艺术与展品",
          "prompts": [
            "a photograph of paintings and artwork in an art gallery or museum",
            "a photograph of sculptures and art exhibits"
          ],
          "labels": [
            "art",
            "painting",
            "sculpture"
          ],
          "theme": null
        },
        "pets": {
          "title": "毛茸茸的日常",
          "label": "宠物时光",
          "prompts": [
            "a photograph of a pet cat or dog at home",
            "a photograph of a cute cat playing or resting"
          ],
          "labels": [
            "cat",
            "dog",
            "feline",
            "canine"
          ],
          "theme": "pet"
        },
        "table": {
          "title": "餐桌上的好时光",
          "label": "餐桌记忆",
          "prompts": [
            "a photograph of delicious food and dishes on a dining table",
            "a photograph of a meal at a restaurant"
          ],
          "labels": [
            "food"
          ],
          "theme": "food"
        },
        "outdoors": {
          "title": "走进山野与天空",
          "label": "自然风景",
          "prompts": [
            "a photograph of mountains forests lakes and beautiful natural scenery",
            "a photograph of the sea and sky outdoors"
          ],
          "labels": [
            "landscape",
            "mountain",
            "lake",
            "ocean",
            "forest"
          ],
          "theme": null
        },
        "stage": {
          "title": "舞台亮起的时候",
          "label": "演出片段",
          "prompts": [
            "a photograph of a live concert or theater performance on stage",
            "a photograph of performers on stage with stage lighting"
          ],
          "labels": [
            "performance",
            "entertainer"
          ],
          "theme": "stage"
        }
      },
      "NEGATIVES": [
        "a screenshot of a phone application interface",
        "a photograph of a receipt document or page of text",
        "a photograph of an ordinary indoor room and furniture"
      ],
      "TOPIC_NEGATIVES": {
        "art": [
          "a photograph of a person posing for a portrait outdoors",
          "a photograph of a bouquet or flower arrangement",
          "a photograph of clothing and accessories displayed for sale"
        ],
        "pets": [
          "a photograph of animal figurines toys and souvenirs on a shelf",
          "a printed illustration of a cat on a poster or product"
        ],
        "table": [
          "a photograph of wild mushrooms growing in a forest",
          "a photograph of plants and leaves growing outdoors"
        ]
      }
    },
    "memories": {
      "VERSION": "unified-memories-v1",
      "RULES": {
        "min_photos": 8,
        "max_photos": 40,
        "max_albums": 18,
        "temporal_split_size": 80,
        "event_hours": 12,
        "event_radius_km": 3,
        "event_context_similarity": 0.6,
        "event_visual_similarity": 0.7,
        "day_similarity": 0.75,
        "trip_padding_hours": 6,
        "trip_radius_km": 30,
        "trip_visual_similarity": 0.55,
        "embedding_duplicate_similarity": 0.985,
        "album_jaccard": 0.8,
        "fragment_containment": 0.8
      }
    },
    "stories": {
      "VERSION": "evidence-stories-v3-subject-timeline",
      "RULES": {
        "minimum_photos": 3,
        "maximum_photos": 12,
        "maximum_albums_per_kind": 10,
        "face_score_min": 0.8,
        "face_blur_min": 50,
        "face_similarity_min": 0.76,
        "face_area_min": 0.004,
        "event_visual_min": 0.62,
        "event_context_visual_min": 0.45,
        "day_visual_min": 0.75,
        "event_max_hours": 6,
        "event_gap_hours": 4,
        "event_radius_km": 1,
        "base_radius_km": 35,
        "base_min_days": 3,
        "base_min_day_share": 0.35,
        "trip_away_km": 50,
        "trip_gap_hours": 72,
        "trip_max_days": 14,
        "trip_min_hours": 4,
        "trip_speed_kmh": 1200,
        "reuse_penalty": 0.35,
        "maximum_photo_uses": 2,
        "minimum_fresh_fraction": 0.6
      }
    },
    "memory_experiment": {
      "VERSION": "memory-experiment-v1"
    }
  },
