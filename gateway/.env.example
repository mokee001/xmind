# Backend-only credentials. Never commit a populated .env or place vendor keys in the iOS app.
DASHSCOPE_API_KEY=
ECHOO_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# All Qwen stages use qwen3.8-flash from echoo_gateway/models.py.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ECHOO_MODERATION_ENDPOINT=green-cip.cn-shanghai.aliyuncs.com
# Set true only after verifying enabled nudity/bloody-violence checks and no exemption-library bypass.
ECHOO_MODERATION_COVERAGE_VERIFIED=false
# Development harness only; production gets session authentication from the app integration.
ECHOO_GATEWAY_SESSION_TOKEN=
ECHOO_GATEWAY_PORT=8787
