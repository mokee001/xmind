{
  "id": "editorial_magazine",
  "name": "杂志编辑风",
  "description": "大图主视觉 + 暖色块 + 编辑式标题排版，像杂志内页",
  "canvas": {
    "width": 1280,
    "height": 720,
    "background": { "type": "gradient", "from": "#F6EFE3", "to": "#EADFCB", "angle": 90 }
  },
  "slots": [
    { "x": 70,  "y": 180, "w": 560, "h": 470, "radius": 22, "border": { "top": 10, "right": 10, "bottom": 10, "left": 10, "color": "#FFFFFF" }, "shadow": true },
    { "x": 720, "y": 180, "w": 460, "h": 210, "radius": 16, "border": { "top": 8, "right": 8, "bottom": 8, "left": 8, "color": "#FFFFFF" }, "shadow": true },
    { "x": 720, "y": 440, "w": 460, "h": 210, "radius": 16, "border": { "top": 8, "right": 8, "bottom": 8, "left": 8, "color": "#FFFFFF" }, "shadow": true }
  ],
  "decorations": [
    { "type": "rect", "layer": "back", "x": 690, "y": 150, "w": 520, "h": 500, "radius": 28, "color": "#E7C9A3" },
    { "type": "circle", "layer": "back", "x": 1120, "y": 48, "w": 96, "h": 96, "outline": "#C98B5F", "outline_width": 6 },
    { "type": "title", "text": "{{title}}", "x": 72, "y": 42, "size": 68, "color": "#3A322A" },
    { "type": "line", "x1": 76, "y1": 128, "x2": 470, "y2": 128, "width": 3, "color": "#C98B5F" },
    { "type": "date", "x": 78, "y": 140, "size": 30, "color": "#9A8C76" },
    { "type": "text", "text": "PHOTO JOURNAL", "x": 76, "y": 662, "size": 24, "color": "#B0A48C", "letter_spacing": 6 }
  ]
}
